{
  "name": "@dudu/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts",
    "./seed": "./seed/data.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:types": "tsx scripts/gen-types.ts",
    "gen:types:remote": "supabase gen types typescript --linked > src/types.gen.ts",
    "seed": "tsx scripts/seed.ts",
    "db:push": "supabase db push",
    "test:rls:remote": "psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f tests/rls.test.sql"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@dudu/config": "workspace:*",
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
