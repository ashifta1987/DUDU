# ─────────────────────────────────────────────────────────────
# DuDu – environment variables. Copy to .env.local and fill in.
# Never commit real values.
# ─────────────────────────────────────────────────────────────

# Supabase (project ref: hhfczwecdgdfxgxalsfl)
# Base URL only — do not append /rest/v1
NEXT_PUBLIC_SUPABASE_URL=https://hhfczwecdgdfxgxalsfl.supabase.co
# Publishable key (sb_publishable_…) — safe in the browser, RLS-enforced
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_…) — server/gateway only, bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=

# Device gateway
GATEWAY_URL=ws://localhost:8787
GATEWAY_DEVICE_SECRET_PEPPER=

# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Pricing (INR) — change without code
DEPOSIT_INR=999
BASIC_INR=299
PLUS_INR=599

# Messaging — WhatsApp Cloud API via adapter: interakt | gupshup | meta
WHATSAPP_PROVIDER=interakt
WHATSAPP_PROVIDER_KEY=

# AI providers (routing lives in the model_routes table)
SARVAM_API_KEY=
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=
GOOGLE_CLOUD_TTS_KEY=
# Legacy per-role keys from the spec; adapters fall back to the provider keys above
STT_API_KEY=
LLM_API_KEY=
LLM_SMALL_API_KEY=
TTS_API_KEY=
VISION_API_KEY=

# Push (Firebase Cloud Messaging only)
FCM_SERVICE_ACCOUNT_JSON=

# Observability / ops
SENTRY_DSN=
SLACK_OPS_WEBHOOK=
CRON_SECRET=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Dev / test only — never enable password login in production
NEXT_PUBLIC_ENABLE_PASSWORD_LOGIN=false
SEED_OWNER_EMAIL=
SEED_TEST_PASSWORD=
